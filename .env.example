# 复制为 .env 后填写。所有密钥都必须自己生成，程序不提供任何默认值，缺失会直接启动失败。

# ---- 数据库（docker compose 与后端共用）----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=kudesi_oa_next
DB_USER=kudesi
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---- 后端 ----
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
# 至少 32 个字符的随机串：  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---- 业务敏感信息加密（AES-256-GCM）----
# 格式 keyId:base64(32字节)，多个用逗号分隔，便于轮换；加密只用 ACTIVE 指定的那把，解密按密文里的 keyId 选。
# 生成一把：  node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_ACTIVE_KEY=k1

# ---- 仅 db:seed 使用（创建第一个公司和管理员）----
SEED_COMPANY_CODE=demo
SEED_COMPANY_NAME=示例公司
SEED_ADMIN_ACCOUNT=admin
SEED_ADMIN_NAME=系统管理员
SEED_ADMIN_PASSWORD=

# ---- 远程协助（可选）----
# 网页和授权电脑不在同一内网时，需要 STUN/TURN 才能连上；不配置则只能同一内网使用。TURN 用 coturn 的 use-auth-secret 方式（共享密钥至少 8 位）。
WEBRTC_STUN_URLS=
WEBRTC_TURN_URLS=
WEBRTC_TURN_SHARED_SECRET=
# 设为 1：服务器端一键关闭远程协助（不接受新申请，进行中的立即结束）
KUDESI_REMOTE_ASSIST_DISABLED=
