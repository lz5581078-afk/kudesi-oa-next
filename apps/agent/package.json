{
  "name": "@kudesi/agent",
  "version": "1.1.1",
  "private": true,
  "description": "酷得斯 OA 店铺登录助手（装在授权电脑上，Windows 为主）",
  "main": "dist/main.js",
  "bin": { "kudesi-agent": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js run",
    "e2e": "npm run build && node scripts/e2e.cjs",
    "pack": "npm run build && node scripts/pack.cjs"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
