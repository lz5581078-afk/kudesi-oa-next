{
  "name": "@kudesi/desktop",
  "version": "0.2.10",
  "private": true,
  "description": "小白OA系统桌面客户端",
  "author": "Kudesi",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "typecheck": "node scripts/navigation.cjs && node scripts/check.cjs && tsc -p tsconfig.json",
    "test": "node --test test/*.test.cjs",
    "build": "npm run typecheck && npm test",
    "dist:win": "node scripts/navigation.cjs && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "node scripts/navigation.cjs && electron-builder --mac dir --publish never",
    "test:native": "electron scripts/native-smoke.cjs",
    "prestart": "node scripts/navigation.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.kudesi.oa.desktop",
    "productName": "小白OA系统",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/navigation.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "XiaobaiOA-Setup-${arch}.${ext}",
      "publish": {
        "provider": "generic",
        "url": "https://github.com/lz5581078-afk/kudesi-oa-next/releases/latest/download/"
      }
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "executableName": "KudesiOA"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
